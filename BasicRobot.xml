<?xml version="1.0" ?>
<mujoco model="simple_robot_world">
  <!-- Compiler settings -->
  <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>
  
  <!-- Default settings -->
  <default>
    <joint type="hinge" damping="1" frictionloss="0.1"/>
    <geom friction="1 0.1 0.1" margin="0.001" condim="3"/>
  </default>
  
  <!-- Assets -->
  <asset>
    <!-- Define textures for the tiled floor -->
    <texture name="floor_texture" type="2d" builtin="checker" width="300" height="300" rgb1="0.2 0.2 0.2" rgb2="0.3 0.3 0.3"/>
    <material name="floor_material" texture="floor_texture" texscale="10 10" reflectance="0.1"/>
  </asset>
  
  <!-- World settings -->
  <option timestep="0.002" iterations="50" gravity="0 0 -9.81"/>
  
  <!-- Lighting -->
  <lighting>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" diffuse="0.8 0.8 0.8" specular="0.5 0.5 0.5"/>
    <light pos="1 1 1" dir="-1 -1 -1" directional="false" diffuse="0.3 0.3 0.3" specular="0.2 0.2 0.2"/>
  </lighting>
  
  <!-- World body -->
  <worldbody>
    <!-- Tiled floor -->
    <geom name="floor" type="plane" size="5 5 0.1" pos="0 0 0" material="floor_material"/>
    
    <!-- Optional: Add walls for better scene containment -->
    <geom name="wall_north" type="plane" size="5 0.1 1" pos="0 5 1" material="floor_material" euler="90 0 0"/>
    <geom name="wall_south" type="plane" size="5 0.1 1" pos="0 -5 1" material="floor_material" euler="90 0 0"/>
    <geom name="wall_east" type="plane" size="0.1 5 1" pos="5 0 1" material="floor_material" euler="0 90 0"/>
    <geom name="wall_west" type="plane" size="0.1 5 1" pos="-5 0 1" material="floor_material" euler="0 90 0"/>
  </worldbody>
</mujoco>